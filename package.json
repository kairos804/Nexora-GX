{
  "name": "nexora-gx",
  "version": "1.2.4",
  "description": "Nexora GX - navegador poderoso e anônimo.",
  "main": "main.js",
  "author": "kairos804",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64 --publish never",
    "build:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.netwaves.nexora-gx",
    "productName": "Nexora GX",
    "files": [
      "index.html",
      "main.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Nexora-GX-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Nexora-GX-Portable-${version}-${arch}.${ext}"
    }
  }
}